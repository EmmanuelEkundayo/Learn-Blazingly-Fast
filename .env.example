# Learn Blazingly Fast — environment variables
# Copy this file to .env and fill in your key before running `npm run dev`

# Anthropic API key — used by the Vite dev server proxy to call Claude for AI hints
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Allowed origins for Express CORS (comma-separated). Defaults to localhost:5173,localhost:3001
# ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# Token used by the admin review manager (Ctrl+Option+O in the header).
# Set the same value in production (Vercel env vars).
REVIEWS_ADMIN_TOKEN=change-me
